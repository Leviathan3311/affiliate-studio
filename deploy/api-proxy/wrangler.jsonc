// Deploy after removing the api.<domain> public hostname from the Cloudflare tunnel:
//   cd deploy/api-proxy && npx wrangler deploy
{
  "name": "growthpilot-api-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "api.growthpilot-spa.online", "custom_domain": true }],
  "vars": { "UPSTREAM_HOST": "leviathan3311--growthpilot-backend-api.us-east.modal.run" }
}
