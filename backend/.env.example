# Copy to .env and fill in. Never commit .env. Every key below is optional in local dev unless marked.

# --- Core -----------------------------------------------------------------------------------------
ENV=dev
# Local: SQLite. Production: Supabase session pooler, e.g.
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./growthpilot.db
# Required outside dev (32+ characters): python -c "import secrets;print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# Encrypts Facebook Page tokens: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
# Password reset email. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<App Password>
# Empty SMTP_HOST in dev = the reset link is printed in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public HTTPS address of this API (Cloudflare Tunnel); Meta and Kaggle call it
API_PUBLIC_URL=http://localhost:8000
# Supabase CA certificate (Database settings -> SSL) for verified TLS, e.g. certs/prod-ca-2021.crt
POSTGRES_SSL_ROOT_CERT=

# --- Facebook (developers.facebook.com) -----------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
# Any random string; the same value goes in the app's Webhooks settings
# META_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
# true = record outgoing messages and posts without sending them to Facebook
META_DRY_RUN=true

# --- AI -------------------------------------------------------------------------------------------
# Customer replies: Groq (console.groq.com) first, Gemini as fallback
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Research, scripts, document reading (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Google Search grounding needs a billed Gemini key
GEMINI_SEARCH=false

# --- Tracing (cloud.langfuse.com); empty = off ----------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- File storage (Cloudflare R2); empty = local ./media folder -----------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=growthpilot-media

# --- GPU workers (Kaggle notebooks) ---------------------------------------------------------------
# Shared secret; the same value goes in the Kaggle secret MEDIA_WORKER_TOKEN
MEDIA_WORKER_TOKEN=
# Start the GPU worker on Modal when a job is queued (see notebooks/modal/growthpilot.py), e.g. growthpilot
MODAL_APP=

# Billing: platform admins confirm bank transfers in /app/admin and extend the plan.
PLATFORM_ADMIN_EMAILS=["you@example.com"]
PLAN_PRICE_VND=499000
TRIAL_DAYS=14
# VietQR on the billing page: BANK_BIN is the NAPAS code (970436 Vietcombank, 970422 MB, 970407 Techcombank, 970418 BIDV)
BANK_BIN=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
