ENV=dev
DATABASE_URL=sqlite:///./growthpilot.db
# DATABASE_URL=postgresql+psycopg://growthpilot:growthpilot@localhost:5432/growthpilot
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
# Fernet key for Page tokens: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# Meta app (developers.facebook.com) — webhook callback: {API_PUBLIC_URL}/api/v1/webhooks/meta
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=growthpilot-verify
META_GRAPH_VERSION=v24.0
# Keep true until the Page is connected and App Review allows pages_messaging
META_DRY_RUN=true

# LLM Router — stream 1: Groq Qwen primary, Gemini fallback
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
